    {
      "name": "5. Payouts (the operator repays the merchant)",
      "item": [
        {
          "name": "Create payout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.batch_header?.payout_batch_id !== undefined) pm.collectionVariables.set('payout_batch_id', j.batch_header?.payout_batch_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{operator_access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender_batch_header\": {\n    \"sender_batch_id\": \"blackbox-{{dispute_id}}\",\n    \"email_subject\": \"Agent operator reimbursement\",\n    \"email_message\": \"Reimbursing the refund on dispute {{dispute_id}}: the agent exceeded the buyer's mandate.\"\n  },\n  \"items\": [\n    {\n      \"recipient_type\": \"PAYPAL_ID\",\n      \"receiver\": \"{{merchant_id}}\",\n      \"amount\": {\n        \"currency\": \"USD\",\n        \"value\": \"90.00\"\n      },\n      \"sender_item_id\": \"{{dispute_id}}\",\n      \"note\": \"Black Box verdict AGENT on {{dispute_id}}: the operator's agent overspent; this repays the merchant's refund.\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v1/payments/payouts",
            "description": "On an AGENT verdict the merchant refunded the overage; the agent operator's account pays it back. PayPal refuses a second batch with the same `sender_batch_id`.\n\nSource: `executor/payout.mjs (reimburse)`"
          }
        },
        {
          "name": "Get payout batch",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
