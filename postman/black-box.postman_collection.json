                "exec": [
                  "const j = pm.response.json();",
                  "if (j.id !== undefined) pm.collectionVariables.set('vault_id', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_source\": {\n    \"token\": {\n      \"id\": \"{{setup_token}}\",\n      \"type\": \"SETUP_TOKEN\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v3/vault/payment-tokens",
            "description": "Turns the approved setup token into the saved wallet (`vault_id`).\n\nSource: `lab/live.mjs (/wallet/return)`"
          }
        },
        {
          "name": "Delete payment token",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{base_url}}/v3/vault/payment-tokens/{{vault_id}}",
            "description": "Forgets the saved wallet.\n\nSource: `lab/live.mjs (/wallet/forget)`"
          }
        }
      ]
    },
    {
      "name": "3. Webhooks",
      "item": [
        {
          "name": "Register webhook",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.id !== undefined) pm.collectionVariables.set('webhook_id', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{webhook_url}}\",\n  \"event_types\": [\n    {\n      \"name\": \"CUSTOMER.DISPUTE.CREATED\"\n    },\n    {\n      \"name\": \"CUSTOMER.DISPUTE.UPDATED\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v1/notifications/webhooks",
            "description": "Subscribes Black Box to dispute events.\n\nSource: `executor/webhook.mjs (--register)`"
          }
        },
        {
          "name": "Verify webhook signature",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"auth_algo\": \"SHA256withRSA\",\n  \"cert_url\": \"\",\n  \"transmission_id\": \"\",\n  \"transmission_sig\": \"\",\n  \"transmission_time\": \"\",\n  \"webhook_id\": \"{{webhook_id}}\",\n  \"webhook_event\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v1/notifications/verify-webhook-signature",
            "description": "Every delivery is checked with PayPal before Black Box acts on it. The values come from the delivery's `PayPal-*` headers and its body.\n\nSource: `executor/webhook.mjs (paypalVerifier)`"
          }
        }
      ]
    },
    {
      "name": "4. Dispute resolution (executor)",
      "item": [
        {
          "name": "List disputes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.items?.[0]?.dispute_id !== undefined) pm.collectionVariables.set('dispute_id', j.items?.[0]?.dispute_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{base_url}}/v1/customer/disputes?page_size=50",
            "description": "The watcher polls this; open disputes go to the autopilot.\n\nSource: `executor/watch.mjs (openDisputes)`"
          }
        },
        {
          "name": "Get dispute",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.disputed_transactions?.[0]?.seller_transaction_id !== undefined) pm.collectionVariables.set('capture_id', j.disputed_transactions?.[0]?.seller_transaction_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{base_url}}/v1/customer/disputes/{{dispute_id}}",
            "description": "`disputed_transactions[0].custom` is the record hash; the seller, buyer and amount feed the record checks, and `links` say which actions PayPal allows now.\n\nSource: `executor/core.mjs (resolveDispute)`"
          }
        },
        {
          "name": "Get capture",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.supplementary_data?.related_ids?.order_id !== undefined) pm.collectionVariables.set('order_id', j.supplementary_data?.related_ids?.order_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{base_url}}/v2/payments/captures/{{capture_id}}",
            "description": "Finds the order behind the disputed capture.\n\nSource: `executor/core.mjs (resolveDispute)`"
          }
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{base_url}}/v2/checkout/orders/{{order_id}}",
            "description": "The order's `create_time`: the shop's pages must be signed before it, and an unsigned mandate counts only if the payer had no passkey yet.\n\nSource: `executor/core.mjs (resolveDispute)`"
          }
        },
        {
          "name": "Escalate (USER: an inquiry, before evidence)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Black Box verdict USER (rule 6): the purchase was within the buyer's mandate. Escalating so PayPal can review the evidence. Record {{record_hash}}.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v1/customer/disputes/{{dispute_id}}/escalate",
            "description": "PayPal takes evidence only on a claim, so an inquiry is escalated once first.\n\nSource: `executor/core.mjs (escalate)`"
          }
        },
        {
          "name": "Accept claim (MERCHANT: full refund)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Black Box verdict MERCHANT (rule 2). Record {{record_hash}}.\",\n  \"accept_claim_type\": \"REFUND\",\n  \"refund_amount\": {\n    \"currency_code\": \"USD\",\n    \"value\": \"240.00\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v1/customer/disputes/{{dispute_id}}/accept-claim",
            "description": "The merchant's own hidden text misled the agent: refund in full. On an AGENT case where the buyer disputed only the overage, the same call refunds that amount in full.\n\nSource: `executor/core.mjs (act, claimAcceptance)`"
          }
        },
        {
          "name": "Accept claim (AGENT: the amount over budget)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Black Box verdict AGENT (rule 5). Record {{record_hash}}.\",\n  \"accept_claim_type\": \"PARTIAL_REFUND\",\n  \"refund_amount\": {\n    \"currency_code\": \"USD\",\n    \"value\": \"90.00\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v1/customer/disputes/{{dispute_id}}/accept-claim",
            "description": "A refund smaller than the disputed amount is sent as `PARTIAL_REFUND`. The code notes that PayPal refuses it on an \"incorrect amount\" claim for only the overage, which is why that case accepts in full (the request above).\n\nSource: `executor/core.mjs (act, claimAcceptance)`"
          }
        },
        {
          "name": "Make offer (AGENT, \"unauthorised\")",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
