  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Get access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access_token !== undefined) pm.collectionVariables.set('access_token', j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{client_secret}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "url": "{{base_url}}/v1/oauth2/token",
            "description": "The merchant's token, used by every request except the payouts.\n\nSource: `lib/paypal.mjs` (createPayPal)"
          }
        },
        {
          "name": "Get operator access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access_token !== undefined) pm.collectionVariables.set('operator_access_token', j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{operator_client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{operator_client_secret}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "url": "{{base_url}}/v1/oauth2/token",
            "description": "The agent operator's token, for the payouts that repay a merchant when the agent was at fault.\n\nSource: `lib/paypal.mjs` (createPayPal)"
          }
        }
      ]
    },
    {
      "name": "1. Checkout (the demo shop)",
      "item": [
        {
          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.id !== undefined) pm.collectionVariables.set('order_id', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intent\": \"CAPTURE\",\n  \"purchase_units\": [\n    {\n      \"reference_id\": \"default\",\n      \"custom_id\": \"{{record_hash}}\",\n      \"description\": \"Summit Pro Shell (RJ-PREMIUM-BLUE-M)\",\n      \"amount\": {\n        \"currency_code\": \"USD\",\n        \"value\": \"240.00\",\n        \"breakdown\": {\n          \"item_total\": {\n            \"currency_code\": \"USD\",\n            \"value\": \"240.00\"\n          }\n        }\n      },\n      \"items\": [\n        {\n          \"name\": \"Summit Pro Shell\",\n          \"sku\": \"RJ-PREMIUM-BLUE-M\",\n          \"quantity\": \"1\",\n          \"category\": \"PHYSICAL_GOODS\",\n          \"unit_amount\": {\n            \"currency_code\": \"USD\",\n            \"value\": \"240.00\"\n          }\n        }\n      ]\n    }\n  ],\n  \"payment_source\": {\n    \"paypal\": {\n      \"experience_context\": {\n        \"brand_name\": \"Driftwood Outfitters\",\n        \"user_action\": \"PAY_NOW\",\n        \"shipping_preference\": \"NO_SHIPPING\",\n        \"return_url\": \"{{shop_origin}}/paypal/return\",\n        \"cancel_url\": \"{{shop_origin}}/paypal/cancel\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v2/checkout/orders",
            "description": "The shop creates the order at its signed catalog price and puts the agent's record hash in `custom_id`, which binds the record to the payment. The buyer approves at the `payer-action` link.\n\nSource: `shop/server.mjs (checkout)`"
          }
        },
        {
          "name": "Capture order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.purchase_units?.[0]?.payments?.captures?.[0]?.id !== undefined) pm.collectionVariables.set('capture_id', j.purchase_units?.[0]?.payments?.captures?.[0]?.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v2/checkout/orders/{{order_id}}/capture",
            "description": "After the buyer approves, the merchant captures at once.\n\nSource: `shop/server.mjs (paypalReturn)`"
          }
        },
        {
          "name": "Create order with saved wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.id !== undefined) pm.collectionVariables.set('order_id', j.id);",
                  "if (j.purchase_units?.[0]?.payments?.captures?.[0]?.id !== undefined) pm.collectionVariables.set('capture_id', j.purchase_units?.[0]?.payments?.captures?.[0]?.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "PayPal-Request-Id",
                "value": "blackbox-{{record_hash}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intent\": \"CAPTURE\",\n  \"purchase_units\": [\n    {\n      \"reference_id\": \"default\",\n      \"custom_id\": \"{{record_hash}}\",\n      \"description\": \"Summit Pro Shell (RJ-PREMIUM-BLUE-M)\",\n      \"amount\": {\n        \"currency_code\": \"USD\",\n        \"value\": \"240.00\",\n        \"breakdown\": {\n          \"item_total\": {\n            \"currency_code\": \"USD\",\n            \"value\": \"240.00\"\n          }\n        }\n      },\n      \"items\": [\n        {\n          \"name\": \"Summit Pro Shell\",\n          \"sku\": \"RJ-PREMIUM-BLUE-M\",\n          \"quantity\": \"1\",\n          \"category\": \"PHYSICAL_GOODS\",\n          \"unit_amount\": {\n            \"currency_code\": \"USD\",\n            \"value\": \"240.00\"\n          }\n        }\n      ]\n    }\n  ],\n  \"payment_source\": {\n    \"paypal\": {\n      \"vault_id\": \"{{vault_id}}\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/v2/checkout/orders",
            "description": "The agent pays by itself with the buyer's saved wallet: PayPal charges it at once, with no checkout screen. The request ID is the record hash, so one record can never be charged twice.\n\nSource: `shop/server.mjs (checkout, vault_id)`"
          }
        }
      ]
    },
    {
      "name": "2. Saved wallet (the live demo's /wallet)",
      "item": [
