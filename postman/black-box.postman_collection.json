              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.id !== undefined) pm.collectionVariables.set('setup_token', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_source\": {\n    \"paypal\": {\n      \"usage_type\": \"MERCHANT\",\n      \"usage_pattern\": \"IMMEDIATE\",\n      \"description\": \"Lets the shopping agent pay at Driftwood Outfitters without a checkout screen\",\n      \"experience_context\": {\n        \"return_url\": \"https://black-box-342881585799.us-central1.run.app/wallet/return\",\n        \"cancel_url\": \"https://black-box-342881585799.us-central1.run.app/wallet\",\n        \"user_action\": \"SETUP_NOW\",\n        \"shipping_preference\": \"NO_SHIPPING\"\n      }\n    }\n  }\n}",
